# PostgreSQL (DATABASE_URL password must be URL-encoded when it contains reserved URL characters)
POSTGRES_DB=mini_game_hub
POSTGRES_USER=mini_game
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://mini_game:replace_with_a_long_random_password@postgres:5432/mini_game_hub

# Backend
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=7d
PORT=3000
APP_ORIGIN=https://game.example.com
COOKIE_SECURE=true

# Only the frontend proxy is published, on localhost for the VPS reverse proxy
WEB_PORT=8080
